#!/usr/bin/env python3
"""ilab — Interaction Lab CLI for AI Coding Agents & Designers.

Zero external dependencies (Python 3 standard library only).

Usage:
  ilab categories                    List all 6 interaction intent categories
  ilab list [category]               List patterns (optionally filtered by category)
  ilab search <query>                Search by name, symptom, or keyword (CN/EN)
  ilab get <slug>                    Fetch full AI-Native blueprint (Markdown)
  ilab get <slug> --raw-html         Fetch full-fidelity standalone HTML specimen
  ilab get <slug> --json             Fetch structured JSON spec

Environment:
  ILAB_URL    Base URL of your Interaction Lab server (default: @@DEFAULT_URL@@)
  ILAB_AGENT  Optional caller tag (e.g. cursor, claude-code, antigravity)
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = "@@DEFAULT_URL@@"
if DEFAULT_URL.startswith("@@"):
    DEFAULT_URL = "http://127.0.0.1:8920"


def base_url(arg_url: str | None) -> str:
    url = arg_url or os.environ.get("ILAB_URL") or DEFAULT_URL
    return url.rstrip("/")


def fetch(url: str) -> bytes:
    agent = os.environ.get("ILAB_AGENT", "").strip()
    ua = f"ilab-cli/1.0 ({agent})" if agent else "ilab-cli/1.0"
    req = urllib.request.Request(url, headers={"User-Agent": ua, "Accept": "application/json, text/markdown, text/plain, */*"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return resp.read()
    except urllib.error.HTTPError as e:
        sys.stderr.write(f"Error: HTTP {e.code} fetching {url}\n")
        sys.exit(1)
    except urllib.error.URLError as e:
        sys.stderr.write(f"Error: cannot reach {url} ({e.reason})\nTip: set ILAB_URL or pass --url\n")
        sys.exit(1)


def cmd_categories(args: argparse.Namespace) -> None:
    data = json.loads(fetch(f"{base_url(args.url)}/api/categories").decode("utf-8"))
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return
    print("# Interaction Lab Categories\n")
    for c in data.get("categories", []):
        print(f"- `{c['id']}` ({c['count']} patterns) — **{c['name_cn']} / {c['name_en']}**")
        print(f"  {c['summary']}")


def cmd_list(args: argparse.Namespace) -> None:
    params = {}
    if args.category:
        params["category"] = args.category
    if args.drive:
        params["drive"] = args.drive
    qs = urllib.parse.urlencode(params)
    url = f"{base_url(args.url)}/api/search" + (f"?{qs}" if qs else "")
    data = json.loads(fetch(url).decode("utf-8"))
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return
    items = data.get("patterns", [])
    print(f"# Interaction Patterns ({len(items)} matches)\n")
    for p in items:
        print(f"- `{p['id']}` [{p['category']}] **{p['name_cn']} ({p['name_en']})**")
        print(f"  {p['essence']}")


def cmd_search(args: argparse.Namespace) -> None:
    q = " ".join(args.query).strip()
    qs = urllib.parse.urlencode({"q": q})
    data = json.loads(fetch(f"{base_url(args.url)}/api/search?{qs}").decode("utf-8"))
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return
    items = data.get("patterns", [])
    if not items:
        print(f"No interaction patterns matched '{q}'. Run `ilab categories` to browse all 6 categories.")
        return
    print(f"# Search Results for '{q}' ({len(items)} matches)\n")
    for p in items:
        print(f"- `{p['id']}` [{p['category']}] **{p['name_cn']} ({p['name_en']})**")
        print(f"  {p['essence']}")
        print(f"  -> Fetch blueprint: `ilab get {p['id']}`")


def cmd_get(args: argparse.Namespace) -> None:
    slug = args.slug.strip()
    root = base_url(args.url)
    if args.raw_html:
        print(fetch(f"{root}/specimens/{slug}.html").decode("utf-8"))
        return
    if args.json:
        qs = urllib.parse.urlencode({"id": slug})
        data = json.loads(fetch(f"{root}/api/search?{qs}").decode("utf-8"))
        items = data.get("patterns", [])
        if not items:
            sys.stderr.write(f"Pattern '{slug}' not found.\n")
            sys.exit(1)
        print(json.dumps(items[0], ensure_ascii=False, indent=2))
        return
    print(fetch(f"{root}/patterns/{slug}.md").decode("utf-8"))


def main() -> None:
    parser = argparse.ArgumentParser(prog="ilab", description="Interaction Lab CLI for AI Agents")
    parser.add_argument("--url", help="Override Interaction Lab server base URL")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_cat = sub.add_parser("categories", help="List all 6 interaction categories")
    p_cat.add_argument("--json", action="store_true", help="Output raw JSON")
    p_cat.set_defaults(func=cmd_categories)

    p_list = sub.add_parser("list", help="List interaction patterns (optionally by category)")
    p_list.add_argument("category", nargs="?", help="Category slug (e.g. feedback-receipts)")
    p_list.add_argument("--drive", help="Filter by drive (press|click|drag|hover|scroll|time|state)")
    p_list.add_argument("--json", action="store_true", help="Output raw JSON")
    p_list.set_defaults(func=cmd_list)

    p_search = sub.add_parser("search", help="Search patterns by keyword or UI symptom")
    p_search.add_argument("query", nargs="+", help="Search terms (CN or EN)")
    p_search.add_argument("--json", action="store_true", help="Output raw JSON")
    p_search.set_defaults(func=cmd_search)

    p_get = sub.add_parser("get", help="Fetch exact AI-Native blueprint for a pattern")
    p_get.add_argument("slug", help="Pattern slug (e.g. coverflow-depth-stage)")
    p_get.add_argument("--raw-html", action="store_true", help="Fetch full high-craft standalone HTML specimen")
    p_get.add_argument("--json", action="store_true", help="Output full JSON metadata")
    p_get.set_defaults(func=cmd_get)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
